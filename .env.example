# ==========================================
# SMLE Configuration Template
# ==========================================

# --- Database Selection ---
# Options: couchbase | cratedb | postgres
DB_TYPE=cratedb

# --- Couchbase Configuration ---
# Used when DB_TYPE=couchbase
CB_CONNECTION_STRING=couchbase://localhost
CB_USERNAME=Administrator
CB_PASSWORD=password
CB_BUCKET=SMLE

# --- CrateDB Configuration ---
# Used when DB_TYPE=cratedb
# Format: postgres://user:password@host:port/schema
CRATE_CONNECTION_STRING=postgres://crate@localhost:5432/doc
CRATE_USERNAME=crate
CRATE_PASSWORD=

# --- PostgreSQL Configuration ---
# Used when DB_TYPE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smle
POSTGRES_CONNECTION_STRING=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# --- Neo4j Configuration ---
# Used for graph analytics (optional, but recommended)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# --- API Server ---
# Port the backend server will listen on
API_PORT=3001
# Secret for signing JWT authentication tokens (use a long random string)
JWT_SECRET=replace-with-secure-random-string

# --- Admin Credentials (Seeding) ---
# Used by scripts like setupAuth.js and createAdminUser.js
ADMIN_USERNAME=root
ADMIN_PASSWORD=replace-with-secure-password

# --- BrightData Configuration (Scraping) ---
# Your Bright Data API Key
BD_API_KEY=your_brightdata_api_key
# The zone name for the SERP API (usually 'serp_api1')
BD_SERP_ZONE=serp_api1

# --- SMLE Vision (Video Analysis) ---
# Scraping Browser credentials (for TikTok/Instagram downloads)
SBR_USERNAME=brd-customer-hl_xxxxxxx-zone-scraping_browser1
SBR_PASSWORD=your_scraping_browser_password

# Web Unlocker credentials (for YouTube downloads)
UNLOCKER_USERNAME=brd-customer-hl_xxxxxxx-zone-web_unlocker1
UNLOCKER_PASSWORD=your_unlocker_password

# --- Platform Search Configuration ---
# Max results to fetch per serp query
MAX_SERP_RESULTS=100
# The Google domain to use (e.g., google.com, google.co.uk)
GOOGLE_DOMAIN=google.com

# --- AI & LLM Configuration ---
# Select provider: ollama (local) | gemini | openai
LLM_PROVIDER=ollama

# Ollama Configuration (Local)
# Endpoint for Ollama service
LLM_ENDPOINT=http://localhost:11434
# Model name for analysis/parsing
LLM_MODEL=llama3.2:1b
# Model name for generating embeddings
EMBEDDING_MODEL=nomic-embed-text
# Vision model for SMLE Vision video analysis (required for video features)
# Pull with: ollama pull llava:latest
VISION_MODEL=llava:latest

# Gemini Configuration (Remote)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Default: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration (Remote)
OPENAI_API_KEY=
# Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- Logging ---
# Values: debug | info | warn | error
LOG_LEVEL=info
